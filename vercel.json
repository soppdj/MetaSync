{
  "version": 2,
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/meta-proxy/(.*)",
      "destination": "https://graph.facebook.com/$1"
    },
    {
      "source": "/api/telegram-proxy/(.*)",
      "destination": "https://api.telegram.org/$1"
    },
    {
      "source": "/((?!assets/|favicon\\.svg|manifest\\.json|sw\\.js|api/).*)",
      "destination": "/index.html"
    }
  ]
}
