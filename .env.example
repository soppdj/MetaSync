# ==============================================================================
# METASYNC BY FATHERLAB - ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Supabase (PostgreSQL Database & Auth)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Meta Ads Graph API (Marketing API v19.0/v20.0)
# Access Token from Meta Developer Portal (System User with ads_read, ads_management)
META_ACCESS_TOKEN=EAAG...
# Ad Account ID without "act_" prefix or with "act_" (e.g. act_1234567890)
META_AD_ACCOUNT_ID=act_1234567890

# 3. Google Gemini API (AI Hypnowriting Studio)
# Get from Google AI Studio (https://aistudio.google.com)
GEMINI_API_KEY=AIzaSy...

# 4. Telegram Bot API (2-Way Alerts & Command Remote Control)
# Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# Target Chat ID or Channel ID for Alert Notifications (from @userinfobot or chat update)
TELEGRAM_CHAT_ID=619284710
# Optional Secret Token to verify Telegram Webhook header (X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=your_secret_key_here
